{
  "name": "rihasham",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=@rihasham/shared",
    "dev:api": "npm run dev --workspace=@rihasham/api",
    "dev:admin": "npm run dev --workspace=@rihasham/admin",
    "dev:mobile": "npm run start --workspace=@rihasham/mobile",
    "db:migrate": "npm run db:migrate --workspace=@rihasham/api",
    "db:seed": "npm run db:seed --workspace=@rihasham/api"
  }
}
