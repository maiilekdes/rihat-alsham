PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,exp://localhost:8081

DATABASE_URL=postgres://user:password@localhost:5432/rihasham

# Firebase Admin SDK (service account) — used to verify ID tokens from the
# mobile app (phone OTP / Google / Facebook all issue Firebase ID tokens)
# and to send FCM push notifications.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Moyasar (payment gateway) — secret key stays server-side only.
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
